# Italy Legal Entry™ — PRODUCTION environment file TEMPLATE (docs/deployment/PRODUCTION_DEPLOYMENT_RUNBOOK.md, step 5).
#
# Installed as /etc/italylegalentry/italylegalentry.env, owner root, group root, mode 0600, then edited ON THE SERVER:
# replace every <...> value. config/settings/prod.py refuses to start while a required value still holds
# a <...> placeholder, a published salt, a short key, a wildcard host or a mail backend that does not deliver.
# Read by systemd itself (EnvironmentFile=, as root) for the application, its timers and /usr/local/sbin/ile-manage —
# so the application's user never needs to read it — and never by Django from disk (prod.py ignores .env files).
#
# Syntax: one KEY=value per line, no spaces around "=", no "export". Quote a value that contains spaces with double
# quotes. Never paste a real value into the repository, a ticket or a chat.
# Generate each secret on the server:  python3 -c 'import secrets; print(secrets.token_urlsafe(64))'

# --- core (REQUIRED) ----------------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# 64 random bytes, URL-safe (86 characters). Rotating it signs everyone out and voids every signed document link.
DJANGO_SECRET_KEY=<generate a secret: 64 random bytes, URL-safe>
# The production host name(s), comma-separated, no scheme. Add www.<your-domain> only if nginx serves it, and the
# temporary validation host while it is in use (runbook, cutover step 3).
DJANGO_ALLOWED_HOSTS=<your-domain>
# The same host name(s) with https://, comma-separated.
DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-domain>
# The database created in step 6 — the CURRENT schema, empty; never the legacy database. The password stays
# URL-safe (letters, digits, - and _), as generated: step 6 reads it from this line.
# Managed PostgreSQL instead (runbook step 6): the cluster's host, port and password, and at the end
# ?sslmode=verify-full&sslrootcert=/srv/italylegalentry/db-ca.crt — verify-full checks the server's certificate and
# name; sslmode=require encrypts but would accept any server.
DATABASE_URL=postgres://italylegalentry:<database-password>@127.0.0.1:5432/italylegalentry
# 48 random bytes, URL-safe (64 characters). Never rotate it without a decision: hashes before and after stop matching.
IP_HASH_SALT=<generate a secret: 48 random bytes, URL-safe>

# --- security -----------------------------------------------------------------------------------------------------
BACKOFFICE_MFA_ENFORCED=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
# 0 until every host of the domain is known to serve valid HTTPS (runbook, «TLS / HTTPS»); then 1. While 0,
# `check --deploy` reports security.W005 / security.W021: expected, and justified by that inventory.
# No default in prod.py: keep both lines, with 0 or 1 — a missing one stops the application from starting.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# One reverse proxy (nginx) in front of the application, writing X-Forwarded-For $remote_addr.
ALLAUTH_TRUSTED_PROXY_COUNT=1
# Do NOT set on this host: ILE_ALLOW_INSECURE_PROD (disables every refusal of prod.py) and ILE_READ_ENV_FILE.
# ILE_ALLOW_INSECURE_PROD=
# ILE_READ_ENV_FILE=

# --- e-mail -------------------------------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp-host>
# 587 with STARTTLS. If outbound 587 is blocked on the droplet, the provider's alternative port (often 2525).
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=1
# A sender your SMTP provider is authorised for (SPF/DKIM). No @legalitalentry.it address until it is activated.
DEFAULT_FROM_EMAIL="Italy Legal Entry <noreply@<sender-domain>>"
PUBLIC_CONTACT_EMAIL=contact@agamieuromed.org
# The one destination of every public form — by rule, no other address.
FORMS_DESTINATION_EMAIL=contact@agamieuromed.org
# 0 = queued in EmailOutbox and delivered by the italylegalentry-send-queued-emails timer (step 10).
NOTIFICATIONS_SEND_IMMEDIATELY=0

# --- storage (step 2 creates both, outside the checkout) ----------------------------------------------------------
# Public media, served by nginx at /media/.
MEDIA_ROOT=/var/lib/italylegalentry/media
# Private documents: NO web-server alias, ever; delivered only by the application after authorisation.
PRIVATE_MEDIA_ROOT=/var/lib/italylegalentry/private

# --- database connections, cache ----------------------------------------------------------------------------------
DB_CONN_MAX_AGE=60
# Empty = local-memory cache. Must stay empty: the Redis client library is not installed (check core.E001).
REDIS_URL=

# --- integrations, scanner ----------------------------------------------------------------------------------------
INTEGRATIONS_TRANSPORT=integrations.transports.LoggingTransport
# Empty = uploads stay «not analysed», which the delivery rule states. No scanner exists in the repository.
DOCUMENT_SCANNER=

# --- not used in production (listed so that nothing read by the settings is missing from this file) --------------
# ILE_VERSION_LABEL — fallback only; the footer shows the back-office's SiteSettings.version_label.
# ILE_VERSION_LABEL=
# DJANGO_DEBUG, ILE_SEED_DEMONSTRATION_DATA — forced off by prod.py whatever they say.
# DJANGO_DEBUG=
# ILE_SEED_DEMONSTRATION_DATA=
# ILE_REFERENCE_DATE — ignored when DEBUG is off.
# ILE_REFERENCE_DATE=
