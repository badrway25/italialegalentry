msgid "E-mail : un professionnel ne se connecte pas à l’espace réservé pour découvrir qu’on l’attend."
msgstr "E-mail: un professionista non accede all’area riservata per scoprire che lo si attende."

#: .\apps\notifications\events.py
msgid "L’état de votre dossier a changé.\n\nRéférence : {case_reference}\nNouvel état : {status}\nÉtat précédent : {previous_status}\n\nLe détail et la prochaine étape figurent dans votre espace réservé."
msgstr "Lo stato del fascicolo è cambiato.\n\nRiferimento: {case_reference}\nNuovo stato: {status}\nStato precedente: {previous_status}\n\nIl dettaglio e la fase successiva sono indicati nell’area riservata."

