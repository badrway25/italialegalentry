# Italy Legal Entry — local environment example. Copy to .env and adjust. NEVER commit .env.
# Every value below is a harmless development placeholder; a server gets its own, from its own
# process environment (config/settings/prod.py ignores this file unless ILE_READ_ENV_FILE=1).
#
# Ogni variabile letta da config/settings/{base,prod}.py compare qui, e
# tests/test_env_example_is_complete.py lo verifica in entrambe le direzioni: nulla di letto manca,
# nulla di dichiarato è ignorato. Prima non era così — DJANGO_CSRF_TRUSTED_ORIGINS è obbligatoria
# in produzione e mancava, e il primo `manage.py check --deploy` con le impostazioni di produzione
# è morto proprio lì.

DJANGO_SETTINGS_MODULE=config.settings.dev
# Se leggere questo file. Di default sì, TRANNE con config.settings.prod, dove viene ignorato: un
# .env di sviluppo copiato su un server non indebolisce la configurazione, la SODDISFA — fornisce
# DJANGO_SECRET_KEY e DJANGO_ALLOWED_HOSTS con valori di sviluppo, e il controllo di produzione non
# ha più nulla da obiettare. Metterlo a 1 per rileggerlo in produzione di proposito.
ILE_READ_ENV_FILE=

# =====================================================================================
# OBBLIGATORIE IN PRODUZIONE — senza default. config/settings/prod.py NON SI AVVIA se
# una di queste tre manca. I valori qui sotto servono solo in locale.
# =====================================================================================
# OBBLIGATORIA. In produzione: almeno 50 caratteri e almeno 5 distinti, altrimenti prod.py si
# rifiuta di partire. Firma sessioni, token CSRF e link firmati dei documenti: ruotarla li invalida.
DJANGO_SECRET_KEY=change-me-dev-only-not-for-production
# OBBLIGATORIA in produzione. In sviluppo base.py usa localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# OBBLIGATORIA in produzione. In sviluppo base.py usa una lista vuota.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# ---- Esecuzione -----------------------------------------------------------------------
DJANGO_DEBUG=1
# PostgreSQL (docker compose espone 5439 per non collidere con altre istanze locali)
DATABASE_URL=postgres://ile:ile-dev-password@127.0.0.1:5439/ile
# Secondi di vita di una connessione al database riusata. 0 = nessun riuso.
DB_CONN_MAX_AGE=0
# Cache opzionale (Redis). Vuoto = cache in memoria locale.
REDIS_URL=

# ---- TLS e irrigidimento --------------------------------------------------------------
# In produzione i default sono true e 31536000; prod.py rifiuta di avviarsi se sono più deboli.
# Vuoto = lascia decidere al modulo di impostazioni. Non copiare questo file su un server così com'è.
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
# Disattiva quel controllo di coerenza. Un solo uso legittimo: dietro un proxy che termina TLS su
# rete privata. Da mettere a verbale quando si usa.
ILE_ALLOW_INSECURE_PROD=
# Secondo fattore (TOTP) per chi legge i dati di altre persone. Spento in locale perché
# un'installazione nuova possa raggiungere /backoffice/; in produzione il default è ACCESO.
BACKOFFICE_MFA_ENFORCED=0
# Sale dell'hash a senso unico degli indirizzi IP. Mai riusare il valore di produzione in locale, e
# mai registrare un IP in chiaro. Ruotarlo spezza la confrontabilità degli hash già scritti.
IP_HASH_SALT=change-me-dev-only-not-for-production

# ---- Posta ----------------------------------------------------------------------------
# In sviluppo la console: nessuna e-mail reale parte mai da questa macchina.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Italy Legal Entry <noreply@example.invalid>
# Invia durante la richiesta invece di accodare. Comodo in sviluppo, sbagliato in produzione:
# l'invio in coda è ciò che rende EmailOutbox il registro di quello che è partito davvero.
NOTIFICATIONS_SEND_IMMEDIATELY=
# Unica destinazione pubblica di tutti i form. Nessun indirizzo @legalitalentry.it finché non è attivato.
PUBLIC_CONTACT_EMAIL=contact@agamieuromed.org
FORMS_DESTINATION_EMAIL=contact@agamieuromed.org

# ---- Contenuti, fasi, dati --------------------------------------------------------------
# Data di riferimento per collaudare i gate (ISO). Vuoto = orologio reale.
ILE_REFERENCE_DATE=
# Mostrata nel piè di pagina e nel badge del back-office. Vuoto = etichetta predefinita.
ILE_VERSION_LABEL=
# Dove vivono i documenti privati. DEVE stare fuori dalla radice web: nulla sotto questo percorso
# è servito dal server, e ogni download passa da una vista che verifica l'autorizzazione.
PRIVATE_MEDIA_ROOT=
# Se un seed può creare record SINTETICI che somigliano a persone reali — account dimostrativi,
# fascicoli, richieste allo sportello, piani formativi. La configurazione e i contenuti pubblicati
# sono sempre seminati; questo governa solo le persone inventate. Default: DJANGO_DEBUG.
# Tenerlo SPENTO ovunque ci siano dati reali; test.py e prod.py lo fissano a false comunque.
ILE_SEED_DEMONSTRATION_DATA=

# ---- Variabili lette FUORI da config/settings (solo sviluppo e test) ----------------------
# Non vanno dichiarate in questo file: tests/test_env_example_is_complete.py rifiuta una variabile
# che nessun modulo di impostazioni legge. Si passano sulla riga di comando quando servono.
#   TEST_DATABASE_URL   config/settings/test.py — database dei test. Una per ogni esecuzione pytest
#                       concorrente (es. postgres://ile:ile-dev-password@127.0.0.1:5439/ile_t_<nome>),
#                       altrimenti due sessioni si bloccano a vicenda sullo stesso test_ile.
#   ILE_SOURCE_DIR      scripts/verify_locked_against_source.py — cartella FUORI dal repository con i
#                       documenti sorgente. Assente = «non verificato», mai «verificato pulito».
#   ILE_DESIGN_PREVIEW  solo sul ramo design-v5 (config/settings/dev.py): =1 con DEBUG monta l'hub di
#                       anteprima V5 in locale. Non esiste in test.py né in prod.py.
#   ILE_CONFIDENTIAL_SENTINELS
#                       tests/security/test_confidential_material.py — file JSON FUORI dal repository
#                       con gli identificativi privati del depositante, coppie [pattern, etichetta].
#                       Non impostata = il test dedicato risulta SALTATO e lo dice; impostata con il
#                       file mancante, illeggibile o vuoto = i test FALLISCONO. Nel .env locale o nella
#                       shell, mai un valore in questo file.

# ---- Agganci opzionali ------------------------------------------------------------------
# Vuoto = i caricamenti privati restano «non analizzati» e la regola di consegna lo dichiara.
DOCUMENT_SCANNER=
# Il trasporto predefinito scrive solo nei log e non contatta mai un endpoint esterno.
INTEGRATIONS_TRANSPORT=integrations.transports.LoggingTransport

# ---- QA locale (solo su questa macchina) ------------------------------------------------
# Password dei tre account QA creati da scripts/qa_prepare_env.py e degli account dimostrativi dello
# sportello (apps/helpdesk/seeds.py). Solo nel .env locale: mai nel repository, mai stampata, mai su
# un server. Vuota = lo script si rifiuta di partire e gli account dimostrativi nascono con una
# password inutilizzabile. È l'unica variabile di questo file che nessun modulo di config/settings
# legge, ed è voluto: una password non diventa un'impostazione, che una pagina d'errore può mostrare.
ILE_QA_PASSWORD=
