# Italy Legal Entry™ — every environment variable the application reads, and the local development template.
#
# DEVELOPMENT: `cp .env.example .env` (README). The uncommented values below run a local checkout as they are.
# PRODUCTION: never copy this file to a server. config/settings/prod.py ignores any .env file (unless
# ILE_READ_ENV_FILE=1); the server's variables come from the systemd EnvironmentFile built from
# docs/deployment/production.env.example — docs/deployment/PRODUCTION_DEPLOYMENT_RUNBOOK.md, step 5.
# Every value here is a harmless placeholder. Never commit a real value, here or anywhere else.
#
# Above each variable: REQUIRED IN PRODUCTION or optional, its default, what it does.
# A commented line (# NAME=...) is an optional variable whose default is right for development: leave it
# commented. With django-environ an EMPTY value is not "unset" — a boolean becomes false, a number fails to
# parse, a path becomes the current directory — so nothing below is declared empty unless empty IS its default.
# tests/test_env_example_is_complete.py keeps this file, the production template and the code in step.

# ============================================================================================================
# CORE
# ============================================================================================================
# REQUIRED IN PRODUCTION (config.settings.prod) · manage.py defaults to .dev, wsgi.py and asgi.py to .prod, pytest to .test.
DJANGO_SETTINGS_MODULE=config.settings.dev
# REQUIRED IN PRODUCTION, no default · signs sessions, CSRF tokens and signed document links; 50+ varied characters.
DJANGO_SECRET_KEY=change-me-dev-only-not-for-production
# REQUIRED IN PRODUCTION, no default · comma-separated host names (example.com,www.example.com); never "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# REQUIRED IN PRODUCTION, no default · comma-separated https:// origins (https://example.com); development default: none.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
# optional · default off (dev.py: on) · development only: prod.py forces DEBUG off whatever this says.
DJANGO_DEBUG=1
# optional · default: read .env, EXCEPT under config.settings.prod · never set it on a server.
# ILE_READ_ENV_FILE=0
# optional · fallback only: the footer shows the back-office's SiteSettings.version_label once the row exists.
# ILE_VERSION_LABEL=v2.0.0 — Fase 1

# ============================================================================================================
# SECURITY
# ============================================================================================================
# REQUIRED IN PRODUCTION, no default (prod.py: 32+ characters, not a placeholder) · salt of the one-way hash of stored IPs.
IP_HASH_SALT=change-me-dev-only-not-for-production
# optional · default off (prod.py: on, and refuses off) · makes TOTP enrolment mandatory for every account that reads
# others' data; a device an account holds is asked for in every session, whatever this says.
BACKOFFICE_MFA_ENFORCED=0
# optional · production default on, prod.py refuses off · redirect HTTP to HTTPS (reads the proxy's X-Forwarded-Proto).
# SECURE_SSL_REDIRECT=1
# optional · production default 31536000, prod.py refuses less · HSTS max-age in seconds.
# SECURE_HSTS_SECONDS=31536000
# REQUIRED IN PRODUCTION, no default · 0 or 1 for the domain: 1 = HSTS includeSubDomains, every subdomain on valid HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# REQUIRED IN PRODUCTION, no default · 0 or 1: the HSTS preload directive; joining the preload list is a separate decision.
SECURE_HSTS_PRELOAD=0
# optional · production default 1 · proxies in front of the app, so allauth's rate limits see the real client address.
# ALLAUTH_TRUSTED_PROXY_COUNT=1
# optional · default off · the ONE escape hatch for prod.py's refusals: staging-like stacks without TLS, never the public host.
# ILE_ALLOW_INSECURE_PROD=1

# ============================================================================================================
# DATABASE — PostgreSQL only (docker compose publishes it on 5439)
# ============================================================================================================
# REQUIRED IN PRODUCTION, no default (prod.py) · development default: the docker compose server below.
DATABASE_URL=postgres://ile:ile-dev-password@127.0.0.1:5439/ile
# optional · default 60 (dev.py: 0) · seconds a connection is reused; 0 for runserver, which opens a thread per socket.
DB_CONN_MAX_AGE=0

# ============================================================================================================
# CACHE
# ============================================================================================================
# optional · default empty = local-memory cache · LEAVE EMPTY: the Redis client library is not in requirements/base.txt
# (manage.py check reports core.E001 if this is set without it).
# REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================================================================
# E-MAIL
# ============================================================================================================
# optional · default console (prod.py: smtp, and refuses console/file/locmem/dummy) · development never sends real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# required for SMTP in production (check --deploy: core.W002) · default empty · SMTP host name.
# EMAIL_HOST=smtp.example.net
# optional · default 587 · SMTP port, STARTTLS (some providers also listen on 2525 where 587 is blocked).
# EMAIL_PORT=587
# optional · default empty · SMTP user name.
# EMAIL_HOST_USER=
# optional · default empty · SMTP password: a secret, the server's environment file only.
# EMAIL_HOST_PASSWORD=
# optional · default on · STARTTLS on the SMTP connection (implicit TLS on port 465 is not configurable).
# EMAIL_USE_TLS=1
# set in production (check --deploy: core.W003) · default «Italy Legal Entry <noreply@example.invalid>» · the sender.
# DEFAULT_FROM_EMAIL=Italy Legal Entry <noreply@example.invalid>
# optional · default contact@agamieuromed.org · the public contact address shown on pages and in e-mails.
PUBLIC_CONTACT_EMAIL=contact@agamieuromed.org
# optional · default contact@agamieuromed.org · the ONE destination of every public form; no other address, by rule.
FORMS_DESTINATION_EMAIL=contact@agamieuromed.org

# ============================================================================================================
# STORAGE
# ============================================================================================================
# optional · default <checkout>/private_media · PRIVATE documents: outside every served directory, delivered only by
# documents.views after authorisation; prod.py refuses it inside MEDIA_ROOT, STATIC_ROOT or STATICFILES_DIRS.
# PRIVATE_MEDIA_ROOT=/var/lib/italylegalentry/private
# optional, read by prod.py only · default <checkout>/media · PUBLIC media (library photos, Forum media, logo) at /media/.
# MEDIA_ROOT=/var/lib/italylegalentry/media

# ============================================================================================================
# NOTIFICATIONS
# ============================================================================================================
# optional · default off (dev.py and test.py: on) · off = queue in EmailOutbox, delivered by the send_queued_emails timer.
# NOTIFICATIONS_SEND_IMMEDIATELY=0

# ============================================================================================================
# INTEGRATIONS
# ============================================================================================================
# optional · default integrations.transports.LoggingTransport (logs only, never opens a socket) · CRM event transport.
INTEGRATIONS_TRANSPORT=integrations.transports.LoggingTransport
# Integration secrets have no fixed name: the back-office names one per system or endpoint (fields
# ExternalSystem.inbound_secret_env and WebhookEndpoint.signing_secret_env) and its value goes in the server's
# environment file under that name. None is configured; the push transport also needs a code change
# (INTEGRATIONS_ALLOW_NETWORK is a setting, not a variable).

# ============================================================================================================
# DOCUMENT SCANNER
# ============================================================================================================
# optional · default empty = uploads stay «not analysed», which the delivery rule states · dotted path of a
# callable(path) -> ScanStatus. No scanner exists in this repository.
# DOCUMENT_SCANNER=

# ============================================================================================================
# CONTENT AND DATA
# ============================================================================================================
# optional · default = DJANGO_DEBUG; prod.py and test.py force it off · may seeds invent people (demo accounts, cases)?
# ILE_SEED_DEMONSTRATION_DATA=1
# optional, development and QA only: ignored when DEBUG is off (core.clock) · ISO date the gates are evaluated at.
# ILE_REFERENCE_DATE=2026-10-03

# ============================================================================================================
# LOCAL QA, PREVIEW, TESTS AND TOOLS — NOT FOR PRODUCTION
# ============================================================================================================
# local only · password of the QA accounts (scripts/qa_prepare_env.py) and of the help desk's demonstration accounts
# (apps/helpdesk/seeds.py); never in the repository, never printed, never on a server. Empty = the script refuses.
ILE_QA_PASSWORD=
# Read by config/settings/dev.py only (the design-v5 preview, DEBUG on); test.py and prod.py never read them:
# ILE_DESIGN_PREVIEW=1                           mounts /__design-v5/ when DEBUG is on
# ILE_DESIGN_PREVIEW_PORT=8780                   the only port the preview answers
# ILE_DESIGN_PREVIEW_DB_CEILING=8                most database connections the preview server holds at once
# ILE_DESIGN_PREVIEW_PROOF_DIR=<folder>          proof captures (default: a Windows path of the studio machine)
# ILE_DESIGN_PREVIEW_LIVE_STATUS=<file>          the steward's live_status.json
# ILE_DESIGN_PREVIEW_CHANGELOG=<file>            the steward's CHANGELOG_V54.md
# ILE_DESIGN_PREVIEW_V4_ORIGIN=http://127.0.0.1:8771   the V4 control the index compares with
# PGAPPNAME=ile-design-preview                   PostgreSQL application_name of the preview's connections
# Read by tests and local tools only — pass them on the command line or keep them in the local .env:
# TEST_DATABASE_URL=postgres://ile:ile-dev-password@127.0.0.1:5439/ile_t_<lane>   one per concurrent pytest run
# ILE_CONFIDENTIAL_SENTINELS=<file outside the repository>   tests/security/test_confidential_material.py
# ILE_SOURCE_DIR=<folder outside the repository>             scripts/verify_locked_against_source.py
# ILE_REDACTION_TABLE=<file outside the repository>          scripts/history_rewrite_index_filter.py
# ILE_QA_BASE=http://127.0.0.1:8770                          scripts/qa_chrome_*.py
# ILE_QA_DB=ile                                              scripts/qa_chrome_signin.py
# PEXELS_API_KEY=<key>                                       scripts/fetch_images.py
# W3A_SCREENSHOT_DIR=<folder>                                tests/frontend/test_console_shell_browser_w3_a.py
# PORTAL_SCREENSHOT_DIR=<folder>                             apps/portal/tests/test_browser.py
# ILE_OVERLAY_SMOKE_ENGINES=firefox,webkit                   tests/frontend/test_overlays_browser_w2_a.py
# PLAYWRIGHT_BROWSERS_PATH=<folder>                          Playwright's own; tests/frontend/test_overlays_browser_w2_a.py
# W3F2_SHOTS=<folder>                                        tests/frontend/test_{content,service}_pages_browser_w3_f2.py
# DJANGO_LIVE_TEST_SERVER_ADDRESS=localhost:<port>           pytest-django's; unset, tests/live_server.py draws a port
#                                                            Chromium accepts (20000–32767) for the browser tests
# Read by docker-compose.staging.yml, which docker compose fills from the shell or the local .env (the staging-like
# stack of docs/STAGING_PERFORMANCE.md; it also needs DJANGO_SECRET_KEY and IP_HASH_SALT, above):
# POSTGRES_PASSWORD=<generate one locally>                  password of that stack's own database; never a committed value
